{
  "name": "@interactive-wallet/wallet-agent",
  "version": "0.1.0",
  "description": "Credo-TS SSI wallet agent for the Interactive Wallet project",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "pnpm build && node dist/index.js",
    "dev": "tsc && node --watch dist/index.js"
  },
  "dependencies": {
    "@credo-ts/anoncreds": "0.7.0",
    "@credo-ts/askar": "0.7.0",
    "@credo-ts/core": "0.7.0",
    "@credo-ts/didcomm": "0.7.0",
    "@credo-ts/indy-vdr": "0.7.0",
    "@credo-ts/node": "0.7.0",
    "@hyperledger/anoncreds-nodejs": "0.4.0",
    "@hyperledger/anoncreds-shared": "0.4.0",
    "@hyperledger/indy-vdr-nodejs": "0.3.0",
    "@hyperledger/indy-vdr-shared": "0.3.0",
    "@openwallet-foundation/askar-nodejs": "0.6.0",
    "@openwallet-foundation/askar-shared": "0.6.0",
    "bs58": "^6.0.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vite-node": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@hyperledger/anoncreds-nodejs",
      "@hyperledger/indy-vdr-nodejs",
      "@openwallet-foundation/askar-nodejs",
      "koffi",
      "cbor-extract",
      "zstd-napi",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
