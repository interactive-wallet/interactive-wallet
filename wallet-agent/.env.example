# Agent identity
AGENT_LABEL=interactive-wallet-agent
AGENT_ENDPOINT=http://localhost:3001

# Wallet storage
WALLET_ID=interactive-wallet
WALLET_KEY=change-this-to-a-secure-32-char-key

# Ports
ADMIN_PORT=3000
INBOUND_PORT=3001

# Indy / VON Network
INDY_NAMESPACE=local:test
# Path to genesis transactions file from the von-network
GENESIS_FILE_PATH=../von-network/genesis.txn
