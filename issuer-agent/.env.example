# Agent identity
AGENT_LABEL=interactive-wallet-issuer
AGENT_ENDPOINT=http://localhost:3003

# Wallet storage
WALLET_ID=interactive-issuer
WALLET_KEY=change-this-to-a-secure-32-char-key

# Ports
ADMIN_PORT=3002
INBOUND_PORT=3003

# Indy / VON Network
INDY_NAMESPACE=local:test
GENESIS_FILE_PATH=../wallet-agent/genesis.txn
VON_NETWORK_URL=http://localhost:9000

# Issuer DID seed (exactly 32 characters)
ISSUER_SEED=0000000000000InteractiveIssuer1
